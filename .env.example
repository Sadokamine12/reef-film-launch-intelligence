# Copy to .env for API local development; never commit real secrets.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://reef:change-me@localhost:5432/reef
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEV_AUTH_BYPASS=false
DB_POOL_SIZE=5
SESSION_HOURS=8

# Next.js server-side only: apps/web/.env.local
API_BASE_URL=http://127.0.0.1:8000
APP_ORIGIN=http://localhost:3000

# Deployment bootstrap only; remove after the first account has been created.
# REEF_ADMIN_EMAIL=admin@your-company.example
# REEF_ADMIN_PASSWORD=generate-a-unique-long-password
